# AdFlow AI — environment template.
# Copy to .env and fill in only what you need. NEVER commit .env.
# Provider keys must never be exposed to the browser (no NEXT_PUBLIC_ prefix).

# ── App ───────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
ALLOW_DEV_LOGIN=true
DEV_USER_EMAIL=demo@tadafq.com
DEV_USER_PASSWORD=demo1234

# ── Database ─────────────────────────────────────────────────────────
# Zero-setup default:
DATABASE_URL=sqlite:///./adflow.db
# Postgres (docker-compose / production):
# DATABASE_URL=postgresql+psycopg://adflow:adflow@localhost:5432/adflow

# ── Queue / cache ────────────────────────────────────────────────────
# inline = in-process thread pool (default, no infra). celery = Redis workers.
JOB_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────────────────
# local = ./storage served at /media. s3 = any S3-compatible endpoint.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=adflow
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ── AI providers ─────────────────────────────────────────────────────
# Leave FORCE_MOCK_PROVIDERS=true to run the entire product on Mock Providers.
# Set it to false once at least one real adapter is implemented and keyed.
FORCE_MOCK_PROVIDERS=true

# LLM (brief interpretation, concepts, script, storyboard, QC)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Voice-over (Iraqi Arabic)
ELEVENLABS_API_KEY=

# Video generation
VEO_API_KEY=
RUNWAY_API_KEY=
SEEDANCE_API_KEY=

# Music
MUSIC_API_KEY=

# ── Cost / quality guardrails ────────────────────────────────────────
DEFAULT_PROJECT_BUDGET_USD=12
MONTHLY_BUDGET_TARGET_USD=50
REGENERATION_RESERVE_RATIO=0.20
QC_APPROVE_THRESHOLD=90
QC_REVIEW_THRESHOLD=85
SCENE_QUALITY_THRESHOLD=90
DEFAULT_QUALITY_LEVEL=smart_premium

# ── Media ────────────────────────────────────────────────────────────
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
ENABLE_LOCAL_RENDER=true

# ── Frontend (NEXT_PUBLIC_* only — never put provider secrets here) ──
# Runtime mode: mock | development | production.
# Leave empty to let src/lib/config.ts decide: demo mode wins, otherwise a
# configured API base means development/production, otherwise mock.
NEXT_PUBLIC_APP_ENV=development

# Public origin of the FastAPI backend. Empty on a deployment with no public
# backend yet — the app then runs in mock mode instead of looking broken.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Legacy alias, still honoured:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Force the bundled demo snapshot instead of a backend (what Netlify runs today).
NEXT_PUBLIC_DEMO_MODE=false

# ── Netlify environment variables ────────────────────────────────────
# Set these in Netlify → Site configuration → Environment variables.
# Today (no public backend):
#   NEXT_PUBLIC_DEMO_MODE=true
#   NEXT_PUBLIC_APP_ENV=mock
# Once the FastAPI backend is publicly hosted:
#   NEXT_PUBLIC_DEMO_MODE=false
#   NEXT_PUBLIC_APP_ENV=production
#   NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
# NEVER add OPENAI_API_KEY / GEMINI_API_KEY / ELEVENLABS_API_KEY / VEO_API_KEY /
# RUNWAY_API_KEY / SEEDANCE_API_KEY / MUSIC_API_KEY to Netlify — those belong to
# the backend host only, and never to a NEXT_PUBLIC_ variable.

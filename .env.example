# AdFlow AI — environment template.
# Copy to .env and fill in only what you need. NEVER commit .env.
# Provider keys must never be exposed to the browser (no NEXT_PUBLIC_ prefix).

# ── App ───────────────────────────────────────────────────────────────
# ENV=production switches CORS to fail-closed and logging to JSON.
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
# The demo login must NOT exist in production.
ALLOW_DEV_LOGIN=true
# Exact frontend origins. A wildcard is refused when ENV=production.
CORS_ORIGINS=["http://localhost:3000"]
# CORS_ORIGINS=["https://adflow-ai-tadafq.netlify.app"]
DEV_USER_EMAIL=demo@tadafq.com
DEV_USER_PASSWORD=demo1234

# ── Database ─────────────────────────────────────────────────────────
# Zero-setup default:
DATABASE_URL=sqlite:///./adflow.db
# Postgres (docker-compose / production):
# DATABASE_URL=postgresql+psycopg://adflow:adflow@localhost:5432/adflow

# ── Queue / cache ────────────────────────────────────────────────────
# inline = in-process thread pool (default, no infra). celery = Redis workers.
JOB_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────────────────
# local = ./storage served at /media. s3 = any S3-compatible endpoint.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=adflow
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ── Providers — LLM ──────────────────────────────────────────────────
# Keys are SERVER-SIDE ONLY. Never prefix a provider key with NEXT_PUBLIC_
# and never set one in Netlify — the browser must never see them.
# With no key, or FORCE_MOCK_PROVIDERS=true, the Mock adapter is used and the
# whole product still works (at $0).
FORCE_MOCK_PROVIDERS=true

# Hero-frame-first: an AI-video scene generates a cheap still and waits for a
# human to approve it before the expensive video call. Turning this off
# restores blind text-to-video — for unattended batch runs only.
REQUIRE_KEYFRAME_APPROVAL=true

#
# Model IDs are CONFIGURATION, not facts. Each model in
# app/providers/catalog.py records the vendor doc it was read from
# (`docs_url`) and the date (`verified_at`); Settings → Providers shows both.
# A model with no verified date has never been confirmed — pin its id here
# from the vendor's own documentation before you enable it.
#
# Verified on 2026-09-12. Re-check before turning FORCE_MOCK_PROVIDERS off.

# ANTHROPIC_API_KEY=          # primary copywriter (Claude Sonnet 5)
# GEMINI_API_KEY=             # text, image AND video — one key covers Veo
# OPENAI_API_KEY=             # optional; no current id verified, models disabled
# ANTHROPIC_LLM_MODEL=        # default: claude-sonnet-5
# GEMINI_LLM_MODEL=           # default: gemini-3.5-flash
# OPENAI_LLM_MODEL=           # required before the OpenAI LLM can be enabled
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=
# OPENAI_BASE_URL=

# ── Providers — Image ────────────────────────────────────────────────
# Hero-frame-first: the still is approved before any paid video call, so the
# image tier matters as much as the video tier.
# GEMINI_IMAGE_MODEL=         # default: gemini-3.1-flash-image
# OPENAI_IMAGE_MODEL=         # required before gpt-image-1 can be enabled

# ── Providers — Video ────────────────────────────────────────────────
# Veo 3.1 ships three price tiers behind ONE key, which is why each tier has
# its own override — the router picks the tier, not the vendor.
# VEO_API_KEY=
# VEO_VIDEO_MODEL_ECONOMY=    # default: veo-3.1-lite-generate-preview  (~$0.05/s)
# VEO_VIDEO_MODEL=            # default: veo-3.1-fast-generate-preview  (~$0.15/s)
# VEO_VIDEO_MODEL_PREMIUM=    # default: veo-3.1-generate-preview       (~$0.40/s)
# VEO_BASE_URL=
#
# RUNWAY_API_KEY=             # fallback only; model id NOT verified
# RUNWAY_VIDEO_MODEL=
# RUNWAY_BASE_URL=
#
# Seedance is DISABLED in the catalog: no official API reference could be
# verified, so the host and id shipped here are unusable. Veo 3.1 Lite covers
# the same price tier with a documented id.
# SEEDANCE_API_KEY=
# SEEDANCE_VIDEO_MODEL=
# SEEDANCE_BASE_URL=
#
# OpenAI Sora is NOT an option: the Videos API and sora-2* models shut down
# on 2026-09-24. The catalog keeps a tombstone entry so it is not re-added.

# ── Providers — Voice ────────────────────────────────────────────────
# No vendor documents an IRAQI dialect voice. For broadcast-quality Iraqi VO,
# clone a real Iraqi voice actor (with written consent) and drive it through
# eleven_v3. eleven_flash_v2_5 is cheaper but does not list Arabic, so it is
# disabled in the catalog.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_MODEL=     # default: eleven_v3
# ELEVENLABS_BASE_URL=

# ── Providers — Music ────────────────────────────────────────────────
# Disabled in the catalog: no vendor chosen. For paid advertising a
# commercially licensed library is safer than generation — the broadcast
# rights are unambiguous.
# MUSIC_API_KEY=
# MUSIC_MODEL=
# MUSIC_BASE_URL=

# ── Provider transport ───────────────────────────────────────────────
PROVIDER_TIMEOUT_SEC=120
PROVIDER_MAX_RETRIES=2
PROVIDER_POLL_TIMEOUT_SEC=600
PROVIDER_POLL_INTERVAL_SEC=5

# ── Webhooks ─────────────────────────────────────────────────────────
# Provider callbacks are rejected unless a secret is set (fail-closed: an
# endpoint that cannot verify a signature must not accept one).
# WEBHOOK_SECRET=
# VEO_WEBHOOK_SECRET=
# RUNWAY_WEBHOOK_SECRET=
# SEEDANCE_WEBHOOK_SECRET=

# ── Cost & budget ────────────────────────────────────────────────────
# Two ceilings, and they fail differently. The per-project budget stops one
# runaway render; the monthly cap stops a month of individually reasonable
# ones adding up to a bill nobody chose. Neither falls back to mock providers
# silently — a mock render looks like a deliverable and is not one, so they
# refuse. Set the cap to 0 to remove the monthly ceiling entirely.
DEFAULT_PROJECT_BUDGET_USD=12
MONTHLY_BUDGET_TARGET_USD=50
MONTHLY_BUDGET_HARD_CAP_USD=60
MONTHLY_BUDGET_ALERT_RATIO=0.8
REGENERATION_RESERVE_RATIO=0.20
# Hard ceiling on what a provider connectivity test may ever spend.
INTEGRATION_TEST_BUDGET_USD=1.0

# ── Quality thresholds ───────────────────────────────────────────────
QC_APPROVE_THRESHOLD=90
QC_REVIEW_THRESHOLD=85
SCENE_QUALITY_THRESHOLD=90
DEFAULT_QUALITY_LEVEL=smart_premium

# ── Media ────────────────────────────────────────────────────────────
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Set false on an instance that should serve the API but never render.
ENABLE_LOCAL_RENDER=true
MAX_UPLOAD_MB=400

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json in production, human locally. Credentials are redacted either way.
LOG_FORMAT=human

# ── Frontend (Next.js) ───────────────────────────────────────────────
# Only NEXT_PUBLIC_* values reach the browser. Nothing secret goes here.
# Leave DEMO_MODE=true until the backend is publicly deployed and verified.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_ENV=mock
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com

# AdFlow AI — environment template.
# Copy to .env and fill in only what you need. NEVER commit .env.
# Provider keys must never be exposed to the browser (no NEXT_PUBLIC_ prefix).

# ── App ───────────────────────────────────────────────────────────────
# ENV=production switches CORS to fail-closed and logging to JSON.
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
# The demo login must NOT exist in production.
ALLOW_DEV_LOGIN=true
# Exact frontend origins. A wildcard is refused when ENV=production.
CORS_ORIGINS=["http://localhost:3000"]
# CORS_ORIGINS=["https://adflow-ai-tadafq.netlify.app"]
DEV_USER_EMAIL=demo@tadafq.com
DEV_USER_PASSWORD=demo1234

# ── Database ─────────────────────────────────────────────────────────
# Zero-setup default:
DATABASE_URL=sqlite:///./adflow.db
# Postgres (docker-compose / production):
# DATABASE_URL=postgresql+psycopg://adflow:adflow@localhost:5432/adflow

# ── Queue / cache ────────────────────────────────────────────────────
# inline = in-process thread pool (default, no infra). celery = Redis workers.
JOB_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# ── Storage ──────────────────────────────────────────────────────────
# local = ./storage served at /media. s3 = any S3-compatible endpoint.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=adflow
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ── Providers — LLM ──────────────────────────────────────────────────
# Keys are SERVER-SIDE ONLY. Never prefix a provider key with NEXT_PUBLIC_
# and never set one in Netlify — the browser must never see them.
# With no key, or FORCE_MOCK_PROVIDERS=true, the Mock adapter is used and the
# whole product still works (at $0).
FORCE_MOCK_PROVIDERS=true
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Model IDs are CONFIGURATION, not facts. The defaults in
# app/providers/catalog.py may be stale — confirm against the vendor's current
# documentation, then pin the id here.
# OPENAI_LLM_MODEL=
# GEMINI_LLM_MODEL=
# OPENAI_BASE_URL=
# GEMINI_BASE_URL=

# ── Providers — Image ────────────────────────────────────────────────
# OPENAI_IMAGE_MODEL=
# GEMINI_IMAGE_MODEL=

# ── Providers — Video ────────────────────────────────────────────────
# VEO_API_KEY=
# RUNWAY_API_KEY=
# SEEDANCE_API_KEY=
# VEO_VIDEO_MODEL=
# RUNWAY_VIDEO_MODEL=
# SEEDANCE_VIDEO_MODEL=
# VEO_BASE_URL=
# RUNWAY_BASE_URL=
# SEEDANCE_BASE_URL=

# ── Providers — Voice ────────────────────────────────────────────────
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_MODEL=
# ELEVENLABS_BASE_URL=

# ── Providers — Music ────────────────────────────────────────────────
# MUSIC_API_KEY=
# MUSIC_MODEL=
# MUSIC_BASE_URL=

# ── Provider transport ───────────────────────────────────────────────
PROVIDER_TIMEOUT_SEC=120
PROVIDER_MAX_RETRIES=2
PROVIDER_POLL_TIMEOUT_SEC=600
PROVIDER_POLL_INTERVAL_SEC=5

# ── Webhooks ─────────────────────────────────────────────────────────
# Provider callbacks are rejected unless a secret is set (fail-closed: an
# endpoint that cannot verify a signature must not accept one).
# WEBHOOK_SECRET=
# VEO_WEBHOOK_SECRET=
# RUNWAY_WEBHOOK_SECRET=
# SEEDANCE_WEBHOOK_SECRET=

# ── Cost & budget ────────────────────────────────────────────────────
DEFAULT_PROJECT_BUDGET_USD=12
MONTHLY_BUDGET_TARGET_USD=50
REGENERATION_RESERVE_RATIO=0.20
# Hard ceiling on what a provider connectivity test may ever spend.
INTEGRATION_TEST_BUDGET_USD=1.0

# ── Quality thresholds ───────────────────────────────────────────────
QC_APPROVE_THRESHOLD=90
QC_REVIEW_THRESHOLD=85
SCENE_QUALITY_THRESHOLD=90
DEFAULT_QUALITY_LEVEL=smart_premium

# ── Media ────────────────────────────────────────────────────────────
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Set false on an instance that should serve the API but never render.
ENABLE_LOCAL_RENDER=true
MAX_UPLOAD_MB=400

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json in production, human locally. Credentials are redacted either way.
LOG_FORMAT=human

# ── Frontend (Next.js) ───────────────────────────────────────────────
# Only NEXT_PUBLIC_* values reach the browser. Nothing secret goes here.
# Leave DEMO_MODE=true until the backend is publicly deployed and verified.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_ENV=mock
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
